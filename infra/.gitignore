# Terraform working directory (provider binaries, modules, etc.)
.terraform/

# Terraform state — never commit, contains resource IDs
*.tfstate
*.tfstate.*

# Plan files
*.tfplan
tfplan*

crash.log
crash.*.log

# Local-backend override for credential-free `terraform validate`. NEVER
# commit it — a committed override would silently switch applies to local state.
backend_override.tf

# Partial backend config naming the state bucket, whose name embeds the AWS
# account ID. Shape: backend.config.example.
backend.config

# NOTE: .terraform.lock.hcl IS committed — it pins provider versions.
